{
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "base_keymap": "VSCode",
  "format_on_save": "on",
  "tab_size": 2,
  "show_whitespaces": "all",
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    }
  },
  "language_models": {
    "openai_compatible": {
      "MLX": {
        "api_url": "http://127.0.0.1:8080/v1",
        "available_models": [
          {
            "name": "mlx-community/Qwen2.5-Coder-3B-Instruct-4bit",
            "display_name": "MLX Qwen2.5 Coder 3B",
            "max_tokens": 32768,
            "capabilities": {
              "tools": false,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          }
        ]
      }
    }
  }
}
